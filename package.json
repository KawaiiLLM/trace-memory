{
  "name": "trace-memory",
  "version": "0.1.0-beta.7",
  "description": "Traceable two-layer memory for coding agents: facts recorded from conversation, consolidated into knowledge, every claim traceable back to the source turn.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "memory",
    "agent",
    "pi",
    "pi-package"
  ],
  "engines": {
    "node": ">=24.6.0"
  },
  "pi": {
    "extensions": [
      "./src/hosts/pi/index.ts"
    ]
  },
  "publishConfig": {
    "tag": "next"
  },
  "scripts": {
    "test": "vitest run --dir tests",
    "typecheck": "tsc --noEmit",
    "smoke:pi": "node tests/hosts/pi/smoke.ts",
    "smoke:package": "node tests/package-smoke.mjs",
    "perf": "node tests/perf/run.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.85.1",
    "@earendil-works/pi-coding-agent": ">=0.85.1",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.1.77",
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@types/node": "^24.10.9",
    "esbuild": "0.28.1",
    "jsonc-parser": "3.3.1",
    "typescript": "^5.6.0",
    "vitest": "4.1.11",
    "zod": "4.3.6"
  },
  "files": [
    "src/core",
    "src/hosts/pi",
    "src/hosts/phase-settings.ts",
    "src/hosts/retired-settings.ts",
    "src/hosts/status-line.ts",
    "src/hosts/trace-menu.ts",
    "docs",
    "CONTEXT.md",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "diff": "^8.0.4"
  }
}
